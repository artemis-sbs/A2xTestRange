# Conformance test: the converter's 2.8 player_slot resolution -- a2x_player_ship(slot)
# resolves a 2.8 player_slot (0..7, the player ships) to the Cosmos player-ship ID (the
# slot-th member of role("__player__")). Used when a mission references the player by slot
# with no explicit create:player (e.g. set_player_carried_type). See a2x/spawn.py player_ship.
#
# Run: python -m cosmos_dev.mission_runner A2xTestRange --map test_convert_player --test 15

=== run_test_convert_player
metadata: ``` yaml
type: test/convert_player
```
    side_ensure("tsn", "TSN")
    p = to_id(player_spawn(0, 0, 0, "P0", "tsn", "tsn_battle_cruiser"))
    add_role(p, "default_player_ship")
    signal_emit("create_player_ships", None)
    await delay_sim(2)

    # slot 0 -> the (first) player ship's ID
    test_expect("player_slot0_resolves_to_id", a2x_player_ship(0) == p, f"a2x_player_ship(0) {a2x_player_ship(0)} expected {p}")
    # a slot with no player ship -> None (no crash)
    test_expect("player_empty_slot_none", a2x_player_ship(5) is None, f"a2x_player_ship(5) {a2x_player_ship(5)} expected None")

    # --- a2x_place_player: a 2.8 create type="player" OUTSIDE <start> PLACES the ship ---
    # 2.8 has 8 fixed player slots and the crew is already flying one, so that command
    # cannot make a 9th ship. The converter emits place_player for every player create in
    # an event; spawning there instead left a second, unmanned hull behind.
    _n_before = len(to_id_list(role("__player__")))
    _moved = a2x_place_player(90000, 0, 90000, slot=0, name="Renamed", side="tsn")
    await delay_sim(1)
    _po = to_object(p)

    test_expect("place_player_returns_the_same_ship", _moved == p,
        f"place_player returned {_moved}, expected the slot-0 ship {p}")
    # the whole point: no new hull
    test_expect("place_player_makes_no_new_ship",
        len(to_id_list(role("__player__"))) == _n_before,
        f"player ships {len(to_id_list(role('__player__')))} expected {_n_before} (unchanged)")
    # 2.8 coords are flipped by a2x_pos, so compare against that, not the raw input
    _want = a2x_pos(90000, 0, 90000)
    test_expect("place_player_moved_the_ship",
        abs(_po.pos.x - _want.x) < 1 and abs(_po.pos.z - _want.z) < 1,
        f"ship at ({_po.pos.x}, {_po.pos.z}) expected ({_want.x}, {_want.z})")
    # 2.8 missions rename per entrance (Medusa's Maze names it Gallimimus at 7 of its 8)
    test_expect("place_player_renamed_in_place", _po.name == "Renamed",
        f"ship name {_po.name!r} expected 'Renamed'")
    # an empty slot is a no-op, not a crash
    test_expect("place_player_empty_slot_is_none", a2x_place_player(1, 0, 1, slot=5) is None,
        "placing into a slot with no ship should return None")
    ->END

@map/test_convert_player "TEST convert_player"
" Conformance test for the converter's 2.8 player_slot -> player-ship ID resolution.
    test_begin("convert_player")
    await task_schedule(run_test_convert_player)
    test_report_strict("convert_player")
