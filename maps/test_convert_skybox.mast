# Conformance test: the converter's 2.8 set_skybox_index mapping -- that
# a2x_set_skybox_index(N) maps the 2.8 index (SB00..SB29) across the LM
# basic_random_skybox media labels deterministically and schedules without error. Cosmos
# has no SB## skyboxes, so the index cycles the available labels (index % 7). Asserts the
# chosen label (a decision). See a2x/terrain.py set_skybox_index.
#
# Run: python -m cosmos_dev.mission_runner A2xTestRange --map test_convert_skybox --test 15

=== run_test_convert_skybox
metadata: ``` yaml
type: test/convert_skybox
```
    # 7 distinct Cosmos skyboxes; index maps by modulo, stable per index.
    l0 = a2x_set_skybox_index(0)
    test_expect("skybox_0_is_sky1", l0 == "sky1", f"index 0 -> {l0} expected sky1")

    l7 = a2x_set_skybox_index(7)
    test_expect("skybox_wraps_modulo", l7 == "sky1", f"index 7 -> {l7} expected sky1 (7 % 7)")

    l10 = a2x_set_skybox_index(10)
    test_expect("skybox_10_stable", l10 == "sky1-rainbow", f"index 10 -> {l10} expected sky1-rainbow (10 % 7 = 3)")

    # same index always picks the same skybox (deterministic)
    test_expect("skybox_deterministic", a2x_set_skybox_index(25) == a2x_set_skybox_index(25), "index 25 not stable")

    # negative / invalid -> random (returns None), must not raise
    test_expect("skybox_negative_random", a2x_set_skybox_index(-1) is None, "index -1 should schedule random (None)")
    ->END

@map/test_convert_skybox "TEST convert_skybox"
" Conformance test for the converter's 2.8 set_skybox_index mapping.
    test_begin("convert_skybox")
    await task_schedule(run_test_convert_skybox)
    test_report_strict("convert_skybox")
